# Stripe Projects manages .env. Put optional settings in .env.app or your process environment.
# Never commit real credentials. Do not replace the managed .env file with this file.

# Required only to enable the optional test-only MPP seller endpoint:
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PROFILE_ID=

# Link buyer authorization uses the official CLI's separate OAuth flow.
# npx @stripe/link-cli auth login

# CartPilot uses the official sandbox coding agent by default.
CARTPILOT_AI_PROVIDER=sandbox
CARTPILOT_AI_ENABLED=false
CARTPILOT_BROWSER_OBSERVE=false
# Enable only after local buyer authorization. Always disabled on PUBLIC_DEMO.
CARTPILOT_LINK_ENABLED=false
# Use idle auto-pause for fast demos; explicit snapshotting is optional.
CARTPILOT_PAUSE_ON_APPROVAL=false
# PUBLIC_ORIGIN=https://your-createos-demo.tyzo.nodeops.app
# CARTPILOT_SANDBOX_ID=

# The separate Rehearsal lab requires approval before paid AI calls.
ALLOW_PAID_AI=false
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
