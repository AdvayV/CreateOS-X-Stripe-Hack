{
  "name": "stripe-createos-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CreateOS x Stripe hackathon agent",
  "scripts": {
    "pretest": "node scripts/build-runtime.mjs",
    "pretest:cloud": "node scripts/build-runtime.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
